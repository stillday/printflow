{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintFlow",
  "version": "0.4.0",
  "identifier": "app.printflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PrintFlow",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#09090b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "3D print project & filament manager",
    "longDescription": "PrintFlow is a fully offline desktop app for 3D printing makers: filament spool inventory with tare-weight tracking, multi-part assembly (BOM) planning, .3mf/.gcode metadata parsing and automatic stock deduction.",
    "copyright": "© PrintFlow",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
